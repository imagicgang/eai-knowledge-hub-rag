LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-project-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CHUNKING_MODE=embedding

# Local Ollama option: uncomment the Ollama blocks in docker-compose.yml, then
# set either or both providers below and start the matching Compose profile.
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# OLLAMA_LLM_MODEL=qwen3:1.7b
# OLLAMA_EMBEDDING_MODEL=bge-m3
